{
  "name": "ai-code-review-agent",
  "displayName": "AI Code Review Agent",
  "description": "Local AI-assisted code review diagnostics with Jira sync",
  "version": "0.0.1",
  "publisher": "henearl11",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Programming Languages"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aiCodeReview.runAnalysis",
    "onCommand:aiCodeReview.syncJira"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCodeReview.runAnalysis",
        "title": "AI Code Review: Analyze Current File"
      },
      {
        "command": "aiCodeReview.syncJira",
        "title": "AI Code Review: Sync Issues to Jira"
      },
      {
        "command": "aiCodeReview.openResults",
        "title": "AI Code Review: Open Results"
      }
    ],
    "configuration": {
      "title": "AI Code Review Agent",
      "properties": {
        "aiCodeReview.backendUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Backend analysis API URL"
        },
        "aiCodeReview.configuration": {
          "type": "string",
          "default": "balanced",
          "enum": ["strict", "balanced", "fast"],
          "description": "Analysis configuration profile"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
