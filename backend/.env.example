# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Jira Configuration
JIRA_HOST=http://localhost:8080
JIRA_USERNAME=admin
JIRA_API_TOKEN=your_token_here
JIRA_PROJECT_KEY=AICR

# Database
DATABASE_URL=sqlite:///./ai_review.db

# Analysis Settings
MAX_FILE_SIZE=1000000
ANALYSIS_TIMEOUT=30
CACHE_ENABLED=True
